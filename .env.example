# myWallet — variables d'environnement.
# Copier ce fichier en `.env.local` pour le développement (jamais commité).
# En production : variables Vercel (Project > Settings > Environment Variables) et secrets GitHub.

# PostgreSQL. Local : base du docker compose. Production : chaîne de connexion Neon (avec ?sslmode=require).
DATABASE_URL=postgres://mywallet:mywallet@localhost:5433/mywallet

# Base dédiée aux tests d'intégration (créée par docker/postgres-init.sql). Vidée par les tests.
TEST_DATABASE_URL=postgres://mywallet:mywallet@localhost:5433/mywallet_test

# Better Auth : secret de signature (32 caractères minimum).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=remplacer-par-un-secret-aleatoire-de-32-caracteres-minimum

# URL publique de l'application (sert aussi d'origine de confiance pour CSRF).
BETTER_AUTH_URL=http://localhost:3000

# Optionnel : sortie Next.js "standalone" (image Docker).
# NEXT_OUTPUT=standalone

# Optionnel : afficher la page /design en production (désactivée par défaut).
# ENABLE_DESIGN_PAGE=1
